# Environment Configuration for Instagram AI Automator

# App Environment & URLs
APP_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
PORT=8000

# Security & JWT Auth
JWT_SECRET_KEY=change_this_to_a_secure_random_32_character_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=instagram_automator
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/instagram_automator

# Redis Cache & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Phase 3+)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Object Storage Configuration (Phase 2+)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STORAGE_BUCKET_NAME=instagram-automator-assets

# Meta / Instagram OAuth Configuration (Phase 5+)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:8000/api/v1/integrations/instagram/callback
